recur 0.1 class HoldemDeal
header {
  scope deck {
    i(a) := (order: OptionalCards)
    o(b) := (cards: Cards)
    d : i(a) -> o(b) ~ "Build or validate a 52-card permutation without changing its owner" by HoldemLab.deck
  }
  scope deal {
    i(b) := deck.o(b)
    o(c) := (holes: HoleCards, board: Cards, burns: Cards, remaining: Cards)
    d : i(b) -> o(c) ~ "Deal a heads-up hand; player 2 receives first and player 1 last" by HoldemLab.deal
  }
}
body {
  deck sync : i(a) -> d(a) -> o(b)
  deal sync : i(b) -> d(b) -> o(c)
  share deck.o(b) -> deal.i(b)
  # ranks 2..14, suits 1..4, no jokers or duplicates. Explicit deck is copied.
  # Positions: P2=(1,3), P1=(2,4); burns=(5,9,11); board=(6,7,8,10,12).
  # Predealt board remains internal until the corresponding street is reached.
  # No shuffle is implicit: inject a seeded shuffled permutation for experiments.
}
footer {
  event deck {
    consume demo.holdem.deck.request
    produce demo.holdem.deck
    state demo.holdem.deck.complete
  }
  warp deck : E0(demo.holdem.deck.todo.current) -> dE(deck.d) -> Ef(demo.holdem.deck.complete)
  event deal {
    consume demo.holdem.deck
    produce demo.holdem.deal
    state demo.holdem.deal.complete
  }
  warp deal : E0(demo.holdem.deal.todo.current) -> dE(deal.d) -> Ef(demo.holdem.deal.complete)
}
