module BlackjackWeb
using Random
module Rules
include("../blackjack-lab/main.blackjack.01.jl")
include("../blackjack-lab/main.blackjack.02.jl")
include("../blackjack-lab/main.blackjack.03.jl")
include("../blackjack-lab/main.blackjack.04.jl")
end

mutable struct Game
    revision::Int
    phase::String
    balance::Int
    starting::Int
    bank::Int
    stake::Int
    escrow::Int
    player::Vector{Int}
    dealer::Vector{Int}
    deck::Vector{Int}
    cursor::Int
    result::String
    profit::Int
    history::Vector{Any}
    stats::Dict{String,Int}
end

integer(x,lo,hi,label) = x isa Integer && !(x isa Bool) && lo<=x<=hi ? Int(x) : throw(ArgumentError("$label must be a whole number from $lo to $hi"))
# publish: demo.blackjack.web.table isolated initial ledger
function newgame(money=500)
    funds=integer(money,20,10000,"Starting chips")
    Game(0,"betting",funds,funds,10000,0,0,Int[],Int[],Int[],1,"",0,Any[],
         Dict("hands"=>0,"wins"=>0,"losses"=>0,"pushes"=>0))
end

function allowed(g)
    if g.phase=="playing"
        actions=["hit","stand"]
        length(g.player)==2 && g.balance>=g.stake && g.bank>=2*g.stake && push!(actions,"double")
        return actions
    end
    actions=String[]
    g.balance>=2 && g.bank>=3 && push!(actions,"deal")
    push!(actions,"reset")
    actions
end

# publish: demo.blackjack.web.view public snapshot, never private deck
function public_state(g)
    hidden=g.phase=="playing"
    dealer=hidden ? Any[g.dealer[1],nothing] : Any[g.dealer...]
    (revision=g.revision, phase=g.phase, balance=g.balance, starting=g.starting,
     bank=g.bank, stake=g.stake, escrow=g.escrow, player=copy(g.player), dealer=dealer,
     player_score=isempty(g.player) ? nothing : Rules.score(g.player),
     dealer_score=hidden || isempty(g.dealer) ? nothing : Rules.score(g.dealer),
     result=g.result, profit=g.profit, net=g.balance+g.escrow-g.starting,
     allowed=allowed(g), history=deepcopy(g.history), stats=copy(g.stats),
     max_bet=min(500,2*(g.balance÷2),2*(g.bank÷3)))
end

function draw!(g,hand)
    g.cursor<=length(g.deck) || throw(ArgumentError("Deck exhausted"))
    push!(hand,g.deck[g.cursor]); g.cursor+=1
end

# consumer: demo.blackjack.cards ace-aware scoring and natural precedence
# publish: demo.blackjack.web.settle conserved one-time payout
function settle!(g)
    g.phase=="playing" || throw(ArgumentError("Hand already settled"))
    outcome=Rules.compare_hands(g.player,g.dealer)
    profit=outcome==:blackjack ? 3*g.stake÷2 : outcome==:win ? g.stake : outcome==:loss ? -g.stake : 0
    g.balance+=g.escrow+profit; g.bank-=profit; g.escrow=0
    g.result=string(outcome); g.profit=profit; g.phase="settled"
    g.stats["hands"]+=1
    g.stats[outcome==:push ? "pushes" : outcome==:loss ? "losses" : "wins"]+=1
    pushfirst!(g.history,(hand=g.stats["hands"],result=g.result,profit=profit,stake=g.stake,
                         balance=g.balance,player=copy(g.player),dealer=copy(g.dealer)))
    length(g.history)>20 && pop!(g.history)
    g
end

function finish!(g)
    if !Rules.score(g.player).bust
        while Rules.score(g.dealer).total<17
            draw!(g,g.dealer)
        end
    end
    settle!(g)
end

# consumer: demo.blackjack.web.play request bundle and expected revision
# publish: demo.blackjack.web.play atomic copied state, or error without mutation
function transition(original,command; order=nothing)
    command isa AbstractDict || throw(ArgumentError("Expected a command object"))
    revision=integer(get(command,"revision",nothing),0,typemax(Int),"Revision")
    revision==original.revision || throw(ArgumentError("Stale revision; refresh the table"))
    action=get(command,"action",nothing)
    action isa AbstractString && action in allowed(original) || throw(ArgumentError("Action is unavailable for this hand"))
    permitted=action=="deal" ? ("action","revision","bet") : action=="reset" ? ("action","revision","money") : ("action","revision")
    all(k->k in permitted,keys(command)) || throw(ArgumentError("Unknown command field"))
    if action=="reset"
        fresh=newgame(get(command,"money",500)); fresh.revision=revision+1
        return fresh
    end
    g=deepcopy(original)
    if action=="deal"
        bet=integer(get(command,"bet",nothing),2,min(500,g.balance),"Bet")
        iseven(bet) || throw(ArgumentError("Use an even bet for exact 3:2 payouts"))
        g.bank>=3*bet÷2 || throw(ArgumentError("House reserve is too low; start a new table"))
        g.deck=order===nothing ? shuffle(RandomDevice(),collect(1:52)) : Rules.deck(order)
        g.cursor=1; empty!(g.player); empty!(g.dealer)
        g.stake=bet; g.escrow=bet; g.balance-=bet; g.result=""; g.profit=0; g.phase="playing"
        for _ in 1:2; draw!(g,g.player); draw!(g,g.dealer); end
        if Rules.score(g.player).natural || Rules.score(g.dealer).natural; settle!(g); end
    elseif action=="hit"
        draw!(g,g.player)
        Rules.score(g.player).total>=21 && finish!(g)
    elseif action=="stand"
        finish!(g)
    elseif action=="double"
        g.balance-=g.stake; g.escrow+=g.stake; g.stake*=2
        draw!(g,g.player); finish!(g)
    end
    g.balance>=0 && g.bank>=0 && g.balance+g.escrow+g.bank==g.starting+10000 || error("Ledger invariant failed")
    g.revision=revision+1
    g
end
end
